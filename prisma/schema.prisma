generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model School {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  logoUrl            String?             @map("logo_url")
  primaryColor       String?             @map("primary_color")
  secondaryColor     String?             @map("secondary_color")
  address            String?
  city               String?
  state              String?
  country            String?
  timezone           String              @default("Asia/Kolkata") @map("timezone")
  currency           String              @default("INR")
  status             SchoolStatus        @default(ACTIVE)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  academicYears      AcademicYear?
  attendanceRecords  AttendanceRecord[]
  auditLogs          AuditLog[]
  classAssignments   ClassAssignment[]
  classEnrollments   ClassEnrollment[]
  classes            Class[]
  invites            Invite[]
  memberships        Membership[]
  parentStudentLinks ParentStudentLink[]
  crudDemos          CrudDemo[]
  students           Student[]
  guardians          Guardian[]
  terms              Term[]
  subjects           Subject[]
  schoolFeatures     SchoolFeature[]
  settings           SchoolSettings?
  sections           Section[]
  subscription       Subscription?

  @@map("schools")
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false) @map("email_verified")
  image         String?
  phone         String?
  avatarUrl     String?      @map("avatar_url")
  status        String       @default("active")
  lastLoginAt   DateTime?    @map("last_login_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  accounts      Account[]
  auditLogs     AuditLog[]
  invitesSent   Invite[]     @relation("InvitedBy")
  memberships   Membership[]
  sessions      Session[]
  studentProfile Student?       @relation("StudentUser")
  guardianProfile Guardian?     @relation("GuardianUser")

  @@map("users")
}

model Membership {
  id                 String              @id @default(cuid())
  schoolId           String              @map("school_id")
  userId             String              @map("user_id")
  role               Role
  status             MembershipStatus    @default(ACTIVE)
  joinedAt           DateTime            @default(now()) @map("joined_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  markedAttendance   AttendanceRecord[]  @relation("MarkedBy")
  attendanceRecords  AttendanceRecord[]  @relation("StudentAttendance")
  teacherAssignments ClassAssignment[]
  studentEnrollments ClassEnrollment[]
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentLinks        ParentStudentLink[] @relation("ParentLinks")
  studentLinks       ParentStudentLink[] @relation("StudentLinks")

  @@unique([schoolId, userId, role])
  @@index([schoolId])
  @@index([userId])
  @@index([status])
  @@map("memberships")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, providerId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("verifications")
}

model Permission {
  id        String   @id @default(cuid())
  role      Role
  resource  String
  action    String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([role, resource, action])
  @@map("permissions")
}

model SchoolSettings {
  id                String    @id @default(cuid())
  schoolId          String    @unique @map("school_id")
  attendanceStart   String?   @map("attendance_start_time")
  attendanceEnd     String?   @map("attendance_end_time")
  language          String    @default("en")
  academicYearStart DateTime? @map("academic_year_start")
  academicYearEnd   DateTime? @map("academic_year_end")
  gradingSystem     String?   @map("grading_system")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  school            School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_settings")
}

model Plan {
  id            String         @id @default(cuid())
  name          String         @unique
  studentLimit  Int            @map("student_limit")
  staffLimit    Int            @map("staff_limit")
  priceMonthly  Int            @map("price_monthly")
  modules       String[]
  createdAt     DateTime       @default(now()) @map("created_at")
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id           String             @id @default(cuid())
  schoolId     String             @unique @map("school_id")
  planId       String             @map("plan_id")
  status       SubscriptionStatus @default(TRIALING)
  studentLimit Int                @map("student_limit")
  staffLimit   Int                @map("staff_limit")
  expiresAt    DateTime?          @map("expires_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  plan         Plan               @relation(fields: [planId], references: [id])
  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Feature {
  id             String          @id @default(cuid())
  key            String          @unique
  name           String
  description    String?
  module         String
  createdAt      DateTime        @default(now()) @map("created_at")
  schoolFeatures SchoolFeature[]

  @@map("features")
}

model SchoolFeature {
  id        String   @id @default(cuid())
  schoolId  String   @map("school_id")
  featureId String   @map("feature_id")
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, featureId])
  @@index([schoolId])
  @@map("school_features")
}

model Invite {
  id          String       @id @default(cuid())
  schoolId    String       @map("school_id")
  email       String
  role        Role
  status      InviteStatus @default(PENDING)
  token       String       @unique
  invitedById String       @map("invited_by_id")
  expiresAt   DateTime     @map("expires_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  invitedBy   User         @relation("InvitedBy", fields: [invitedById], references: [id])
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([email])
  @@index([token])
  @@map("invites")
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String?  @map("school_id")
  userId    String?  @map("user_id")
  action    String
  entity    String
  recordId  String?  @map("record_id")
  before    Json?
  after     Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  school    School?  @relation(fields: [schoolId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([userId])
  @@index([createdAt])
  @@index([entity, recordId])
  @@map("audit_logs")
}

model AcademicYear {
  id        String             @id @default(cuid())
  schoolId  String             @unique(map: "academic_years_school_id_is_active_key", where: raw("(is_active = true)")) @map("school_id")
  name      String
  startDate DateTime           @map("start_date") @db.Date
  endDate   DateTime           @map("end_date") @db.Date
  isActive  Boolean            @default(false) @map("is_active")
  status    AcademicYearStatus @default(ACTIVE)
  createdBy String?            @map("created_by")
  updatedBy String?            @map("updated_by")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  school    School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes   Class[]
  terms     Term[]
  enrollments StudentEnrollment[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([schoolId, isActive])
  @@map("academic_years")
}

model Section {
  id          String        @id @default(cuid())
  schoolId    String        @map("school_id")
  name        String
  description String?
  status      SectionStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  classes     Class[]
  studentEnrollments StudentEnrollment[]
  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("sections")
}

model Class {
  id                String             @id @default(cuid())
  schoolId          String             @map("school_id")
  academicYearId    String             @map("academic_year_id")
  sectionId         String             @map("section_id")
  name              String
  gradeLevel        String?            @map("grade_level")
  status            ClassStatus        @default(ACTIVE)
  isDeleted         Boolean            @default(false) @map("is_deleted")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  createdBy         String?            @map("created_by")
  updatedBy         String?            @map("updated_by")
  attendanceRecords AttendanceRecord[]
  assignments       ClassAssignment[]
  enrollments       ClassEnrollment[]
  studentEnrollments StudentEnrollment[]
  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id])
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section           Section            @relation(fields: [sectionId], references: [id])

  @@unique([schoolId, academicYearId, sectionId, name])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([gradeLevel])
  @@index([sectionId])
  @@map("classes")
}

model ClassAssignment {
  id                  String           @id @default(cuid())
  schoolId            String           @map("school_id")
  classId             String           @map("class_id")
  teacherMembershipId String           @map("teacher_membership_id")
  role                AssignmentRole   @default(PRIMARY)
  status              AssignmentStatus @default(ACTIVE)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  class               Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  school              School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherMembership   Membership       @relation(fields: [teacherMembershipId], references: [id], onDelete: Cascade)

  @@unique([classId, teacherMembershipId, role], map: "class_assignments_class_id_teacher_role_key", where: raw("(status = 'ACTIVE'::\"AssignmentStatus\")"))
  @@index([schoolId])
  @@index([classId])
  @@index([teacherMembershipId])
  @@map("class_assignments")
}

model ClassEnrollment {
  id                  String           @id @default(cuid())
  schoolId            String           @map("school_id")
  classId             String           @map("class_id")
  studentMembershipId String           @map("student_membership_id")
  status              EnrollmentStatus @default(ACTIVE)
  joinedAt            DateTime         @default(now()) @map("joined_at")
  leftAt              DateTime?        @map("left_at")
  isDeleted           Boolean          @default(false) @map("is_deleted")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  class               Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  school              School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentMembership   Membership       @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([classId, studentMembershipId], map: "class_enrollments_class_id_student_key", where: raw("(status = 'ACTIVE'::\"EnrollmentStatus\")"))
  @@index([schoolId])
  @@index([classId])
  @@index([studentMembershipId])
  @@map("class_enrollments")
}

model ParentStudentLink {
  id                  String           @id @default(cuid())
  schoolId            String           @map("school_id")
  parentMembershipId  String           @map("parent_membership_id")
  studentMembershipId String           @map("student_membership_id")
  relationship        Relationship     @default(FATHER)
  status              AssignmentStatus @default(ACTIVE)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  createdBy           String?          @map("created_by")
  updatedBy           String?          @map("updated_by")
  parentMembership    Membership       @relation("ParentLinks", fields: [parentMembershipId], references: [id], onDelete: Cascade)
  school              School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentMembership   Membership       @relation("StudentLinks", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([parentMembershipId, studentMembershipId], map: "parent_student_links_parent_student_key", where: raw("(status = 'ACTIVE'::\"AssignmentStatus\")"))
  @@index([schoolId])
  @@index([parentMembershipId])
  @@index([studentMembershipId])
  @@map("parent_student_links")
}

model AttendanceRecord {
  id                   String           @id @default(cuid())
  schoolId             String           @map("school_id")
  classId              String           @map("class_id")
  studentMembershipId  String           @map("student_membership_id")
  date                 DateTime         @db.Date
  status               AttendanceStatus @default(PRESENT)
  markedByMembershipId String           @map("marked_by_membership_id")
  markedAt             DateTime         @default(now()) @map("marked_at")
  notes                String?
  isDeleted            Boolean          @default(false) @map("is_deleted")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  createdBy            String?          @map("created_by")
  updatedBy            String?          @map("updated_by")
  class                Class            @relation(fields: [classId], references: [id])
  markedByMembership   Membership       @relation("MarkedBy", fields: [markedByMembershipId], references: [id])
  school               School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentMembership    Membership       @relation("StudentAttendance", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([studentMembershipId, date], map: "attendance_records_student_date_key", where: raw("(is_deleted = false)"))
  @@index([schoolId, date])
  @@index([classId, date])
  @@index([studentMembershipId, date])
  @@map("attendance_records")
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  VICE_PRINCIPAL
  HR
  ACCOUNTANT
  TEACHER
  CLASS_TEACHER
  NON_TEACHING
  LIBRARIAN
  TRANSPORT_MANAGER
  DRIVER
  CAFETERIA_STAFF
  STUDENT
  PARENT
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ClassStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SectionStatus {
  ACTIVE
  INACTIVE
}

enum AcademicYearStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  TRANSFERRED
  COMPLETED
}

enum AssignmentRole {
  PRIMARY
  ASSISTANT
  SUBSTITUTE
}

enum AssignmentStatus {
  ACTIVE
  REMOVED
}

enum Relationship {
  FATHER
  MOTHER
  GUARDIAN
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

// ── Sprint 3.1: CRUD Infrastructure Demo Entity ──
model CrudDemo {
  id          String   @id @default(cuid())
  schoolId    String   @map("school_id")
  title       String
  description String?
  category    String   @default("general")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("crud_demos")
}

// ── Sprint 3.2: Academic Structure ──
enum TermStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

model Term {
  id             String     @id @default(cuid())
  schoolId       String     @map("school_id")
  academicYearId String     @map("academic_year_id")
  name           String
  startDate      DateTime   @map("start_date") @db.Date
  endDate        DateTime   @map("end_date") @db.Date
  status         TermStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId])
  @@index([academicYearId])
  @@map("terms")
}

model Subject {
  id          String   @id @default(cuid())
  schoolId    String   @map("school_id")
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("subjects")
}

// ── Sprint 3.3A: Student Management ──
enum StudentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
  GRADUATED
  ARCHIVED
}

model Student {
  id              String        @id @default(cuid())
  schoolId        String        @map("school_id")
  userId          String?       @unique @map("user_id")
  admissionNumber String        @map("admission_number")
  firstName       String        @map("first_name")
  lastName        String        @map("last_name")
  dateOfBirth     DateTime?     @map("date_of_birth") @db.Date
  gender          String?
  photoUrl        String?       @map("photo_url")
  phone           String?
  address         String?
  status          StudentStatus @default(ACTIVE)
  isDeleted       Boolean       @default(false) @map("is_deleted")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  school          School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user            User?               @relation("StudentUser", fields: [userId], references: [id], onDelete: SetNull)
  enrollments     StudentEnrollment[]
  guardians       StudentGuardian[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([schoolId, status])
  @@map("students")
}

model StudentEnrollment {
  id              String           @id @default(cuid())
  studentId       String           @map("student_id")
  academicYearId  String           @map("academic_year_id")
  classId         String           @map("class_id")
  sectionId       String           @map("section_id")
  rollNumber      String           @map("roll_number")
  status          EnrollmentStatus @default(ACTIVE)
  enrolledAt      DateTime         @default(now()) @map("enrolled_at")
  leftAt          DateTime?        @map("left_at")
  isDeleted       Boolean          @default(false) @map("is_deleted")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  class           Class            @relation(fields: [classId], references: [id], onDelete: Restrict)
  section         Section          @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([academicYearId])
  @@index([classId])
  @@index([sectionId])
  @@unique([academicYearId, classId, sectionId, rollNumber])
  @@map("student_enrollments")
}

model Guardian {
  id              String            @id @default(cuid())
  schoolId        String            @map("school_id")
  userId          String?           @unique @map("user_id")
  firstName       String            @map("first_name")
  lastName        String            @map("last_name")
  relationship    String
  phone           String?
  email           String?
  address         String?
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user            User?             @relation("GuardianUser", fields: [userId], references: [id], onDelete: SetNull)
  studentLinks    StudentGuardian[]

  @@index([schoolId])
  @@map("guardians")
}

model StudentGuardian {
  id          String   @id @default(cuid())
  studentId   String   @map("student_id")
  guardianId  String   @map("guardian_id")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian    Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@unique([studentId, isPrimary], map: "student_guardians_student_id_primary_key", where: raw("(is_primary = true)"))
  @@index([studentId])
  @@index([guardianId])
  @@map("student_guardians")
}
